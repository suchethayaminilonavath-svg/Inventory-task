# Environment Configuration for StockPilot

# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (Default SQLite for instant zero-config testing & development)
DATABASE_URL="file:./stockpilot.db"

# For PostgreSQL production, uncomment and update the connection string:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stockpilot?schema=public"

# Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production-min32chars
JWT_EXPIRES_IN=24h

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
