{
  "name": "stockpilot",
  "version": "1.0.0",
  "description": "StockPilot - Smart Inventory and Warehouse Management Platform",
  "private": true,
  "scripts": {
    "dev:backend": "tsx watch backend/src/server.ts",
    "dev:frontend": "npm run --prefix frontend dev",
    "dev": "tsx watch backend/src/server.ts",
    "build:backend": "tsc -p backend/tsconfig.json",
    "build:frontend": "npm run --prefix frontend build",
    "build": "npm run build:backend && npm run build:frontend",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "setup": "npm run prisma:generate && npm run prisma:push && npm run prisma:seed",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.10",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
